# Every variable here is optional. With none of them set, JodiDar AI runs fully
# offline on seeded mock data: in-memory database, simulated escrow, demo login
# and deterministic AI fallbacks.

# --- Database -------------------------------------------------------------
# MongoDB Atlas connection string. Unset or unreachable -> in-memory mongomock.
MONGODB_URI=
MONGODB_DB=jodidar

# --- AI ---------------------------------------------------------------------
# Language-model key and model ID. Both must be set to enable live AI;
# otherwise deterministic templates are used and every screen still works.
ANTHROPIC_API_KEY=
AI_MODEL=

# --- Payments -----------------------------------------------------------------
# Razorpay TEST-mode keys (rzp_test_...). Unset -> demo mode records simulated
# payments (labelled so); outside demo mode funding is refused (no money moves).
# A failed Razorpay call is an error, never a simulated success.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you set on the Razorpay webhook (Dashboard > Settings > Webhooks) pointing at
# https://<your-host>/api/payments/razorpay/webhook with payment.captured, order.paid
# and payment.failed. Unset -> the webhook route answers 503.
RAZORPAY_WEBHOOK_SECRET=

# --- Auth ---------------------------------------------------------------------
# Firebase web config. Unset -> "Demo login" role picker.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- Accounts and demo mode ---------------------------------------------------
# 1 = the sandbox: seeded personas, persona sign-in, the Reset button and timed resets.
# 0 (the API's default) = real accounts only. `make dev` and the Docker image set 1
# unless you set it here.
DEMO_MODE=
# How long a sign-in lasts before the user signs in again (hours).
SESSION_HOURS=72

# --- Demo clock ---------------------------------------------------------------
# The date the demo treats as "today" so seeded deadlines stay consistent.
DEMO_TODAY=2026-10-08
