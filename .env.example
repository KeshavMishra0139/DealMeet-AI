# Every variable here is optional. With none of them set, JodiDar AI runs fully
# offline on seeded mock data: in-memory database, simulated escrow, demo login
# and deterministic AI fallbacks.

# --- Database -------------------------------------------------------------
# MongoDB Atlas connection string (mongodb+srv://USER:PASSWORD@cluster.xxxx.mongodb.net/).
# The API never falls back to memory on its own: without USE_MOCK_DB=1, a missing or
# unreachable MONGODB_URI stops startup with a clear message.
MONGODB_URI=
MONGODB_DB=jodidar
# 1 = in-memory mongomock (tests, local demo; data is lost on restart). `make dev` sets it
# when MONGODB_URI is empty, and the Docker image sets it for the shared demo.
USE_MOCK_DB=

# --- AI ---------------------------------------------------------------------
# Language-model key and model ID. Both must be set to enable live AI;
# otherwise deterministic templates are used and every screen still works.
ANTHROPIC_API_KEY=
AI_MODEL=

# --- Payments -----------------------------------------------------------------
# Razorpay TEST-mode keys (rzp_test_...). Unset -> demo mode records simulated
# payments (labelled so); outside demo mode funding is refused (no money moves).
# A failed Razorpay call is an error, never a simulated success.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you set on the Razorpay webhook (Dashboard > Settings > Webhooks) pointing at
# https://<your-host>/api/payments/razorpay/webhook with payment.captured, order.paid
# and payment.failed. Unset -> the webhook route answers 503.
RAZORPAY_WEBHOOK_SECRET=

# --- Firebase sign-in (Google and phone OTP) -----------------------------------
# Web config (Firebase console > Project settings > Your apps). Baked into the web
# build. Unset -> the sign-in page offers email and password only.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Server side: every Firebase ID token is verified with the Admin SDK before an account
# is used. Give it a service account (Project settings > Service accounts > Generate new
# private key): either the whole JSON on one line, or a path to the file. Never commit it.
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
# Optional: the project id, if it differs from VITE_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=

# --- Accounts and demo mode ---------------------------------------------------
# 1 = the sandbox: seeded personas, persona sign-in, the Reset button and timed resets.
# 0 (the API's default) = real accounts only. `make dev` and the Docker image set 1
# unless you set it here.
DEMO_MODE=
# How long a sign-in lasts before the user signs in again (hours).
SESSION_HOURS=72

# --- YouTube (public channel data, no login) --------------------------------------
# A YouTube Data API v3 key (Google Cloud console > APIs & Services > Credentials).
# Powers the public "What am I worth?" page and linking a channel by @handle.
# Unset -> both say YouTube data isn't connected. Responses are cached 12 hours.
YOUTUBE_API_KEY=

# --- Demo clock ---------------------------------------------------------------
# The date the demo treats as "today" so seeded deadlines stay consistent.
DEMO_TODAY=2026-10-08
