# Every variable here is optional. With none of them set, DealMeet AI runs fully
# offline on seeded mock data: in-memory database, simulated escrow, demo login
# and deterministic AI fallbacks.

# --- Database -------------------------------------------------------------
# MongoDB Atlas connection string (mongodb+srv://USER:PASSWORD@cluster.xxxx.mongodb.net/).
# The API never falls back to memory on its own: without USE_MOCK_DB=1, a missing or
# unreachable MONGODB_URI stops startup with a clear message.
MONGODB_URI=
MONGODB_DB=jodidar
# 1 = in-memory mongomock (tests, local demo; data is lost on restart). `make dev` sets it
# when MONGODB_URI is empty, and the Docker image sets it for the shared demo.
USE_MOCK_DB=
# Atlas Search index on the brands collection, used by the brand directory when the
# app runs on MongoDB Atlas (index definition: backend/atlas/brands_search.json).
# Leave unset for "brands_search"; set it empty or "off" to use plain text matching.
ATLAS_SEARCH_INDEX=brands_search

# --- AI ---------------------------------------------------------------------
# Language-model key and model ID. Both must be set to enable live AI;
# otherwise deterministic templates are used and every screen still works.
ANTHROPIC_API_KEY=
AI_MODEL=
# Or through OpenRouter (https://openrouter.ai), used when ANTHROPIC_API_KEY is empty:
# set OPENROUTER_API_KEY and put OpenRouter's model id in AI_MODEL (Anthropic's models
# are listed there as "anthropic/<name>"; copy the exact id from openrouter.ai/models).
# The account needs credits for paid models.
OPENROUTER_API_KEY=
# Cap on live AI calls per hour across all visitors; beyond it, templates are used.
# 0 or empty: no cap (every AI feature runs on every request that needs it).
AI_MAX_CALLS_PER_HOUR=0

# --- Payments -----------------------------------------------------------------
# Razorpay TEST-mode keys (rzp_test_...). Unset -> demo mode records simulated
# payments (labelled so); outside demo mode funding is refused (no money moves).
# A failed Razorpay call is an error, never a simulated success.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you set on the Razorpay webhook (Dashboard > Settings > Webhooks) pointing at
# https://<your-host>/api/payments/razorpay/webhook with payment.captured, order.paid
# and payment.failed. Unset -> the webhook route answers 503.
RAZORPAY_WEBHOOK_SECRET=

# --- Firebase sign-in (Google and phone OTP) -----------------------------------
# Web config (Firebase console > Project settings > Your apps). Baked into the web
# build. Unset -> the sign-in page offers email and password only.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Server side: every Firebase ID token is verified with the Admin SDK before an account
# is used. Give it a service account (Project settings > Service accounts > Generate new
# private key): either the whole JSON on one line, or a path to the file. Never commit it.
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
# Optional: the project id, if it differs from VITE_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=

# --- Accounts and demo mode ---------------------------------------------------
# 1 = the sandbox: seeded personas, persona sign-in, the Reset button and timed resets.
# 0 (the API's default) = real accounts only. `make dev` and the Docker image set 1
# unless you set it here.
DEMO_MODE=
# 1 = add a "Demo admin" persona to the demo sign-in, for walking through the admin
# console locally. Ignored unless DEMO_MODE=1, and ignored on a demo that resets itself
# (DEMO_RESET_MINUTES > 0, i.e. a shared URL). `make dev` sets 1 unless you set it here.
# Real admins are granted on the server: python -m app.admin_cli grant <email>
DEMO_ADMIN=
# Live site (DEMO_MODE=0): 1 = remove every sample record left from demo mode at start
# (sample creators, brands, campaigns, deals and demo accounts, and anything tied to
# them). Real accounts and their data stay. Safe to leave on.
REMOVE_SAMPLE_DATA=
# Shared URL only: put the demo data back to its seeded state every N minutes when idle
# (0 = never). The Docker image sets 30.
DEMO_RESET_MINUTES=0
# How long a sign-in lasts before the user signs in again (hours).
SESSION_HOURS=72

# --- YouTube (public channel data, no login) --------------------------------------
# A YouTube Data API v3 key (Google Cloud console > APIs & Services > Credentials).
# Powers the public "Know your page" page and linking a channel by @handle. With the
# Firebase settings above it also turns on "Continue with YouTube" for creators (add the
# youtube.readonly scope to the OAuth consent screen).
# Unset -> both say YouTube data isn't connected. Responses are cached 12 hours.
YOUTUBE_API_KEY=

# --- Instagram (Business Login for Instagram, read-only) --------------------------
# From your Meta app (developers.facebook.com > your app > Instagram > API setup with
# Instagram login). Turns on connecting Instagram and "Continue with Instagram" for
# creators. Unset -> Instagram shows "not available" and nothing is simulated.
IG_APP_ID=
IG_APP_SECRET=
# Must be HTTPS and listed in the Meta app's OAuth redirect URIs, e.g.
# https://your-app.onrender.com/api/connect/instagram/callback (or an ngrok URL locally).
IG_REDIRECT_URI=
# Where to send the browser back after connecting or signing in with Instagram (defaults
# to the API's own address). Set it when the web app runs on a different address.
FRONTEND_URL=
# Encrypts OAuth tokens at rest. Generate once and keep it secret:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it makes saved tokens unreadable (creators reconnect).
TOKEN_ENC_KEY=
# Graph API version and demographics window. Check both in Meta's changelog.
IG_GRAPH_VERSION=v25.0
IG_DEMOGRAPHICS_TIMEFRAME=this_month

# --- Protected computation (TEE, optional) -----------------------------------
# Unset TEE_ENDPOINT -> the TEE status is "not_configured" and the audience overlap brands
# see runs on this server from minimised data (the documented fallback). Nothing is ever
# described as a TEE unless an AWS Nitro Enclaves attestation verifies against these:
# The enclave app's proxy on the parent instance (see backend/app/services/tee.py).
TEE_ENDPOINT=
# The AWS Nitro Enclaves root certificate: PEM text or a path to the .pem file. Download it
# from the AWS Nitro Enclaves docs and check its SHA-256 fingerprint against the one AWS publishes.
TEE_TRUST_ROOT=
# Measurement policy: JSON of the PCR values your enclave image must have, from
# `nitro-cli build-enclave` (PCR0 image, PCR1 kernel, PCR2 application), e.g.
# {"0": "<96 hex chars>", "1": "<96 hex chars>", "2": "<96 hex chars>"}
TEE_MEASUREMENTS=
# Oldest attestation document accepted, in seconds.
TEE_ATTESTATION_MAX_AGE_S=300

# --- Demo clock ---------------------------------------------------------------
# The date the demo treats as "today" so seeded deadlines stay consistent.
DEMO_TODAY=2026-10-08
