{
  "name": "jodidar-ai",
  "private": true,
  "version": "0.1.0",
  "description": "JodiDar AI: creator monetisation and brand opportunity engine",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "demo": "node scripts/dev.mjs --single-port",
    "e2e": "npm install --no-audit --no-fund --silent && node qa/flows.mjs",
    "accounts": "npm install --no-audit --no-fund --silent && node qa/accounts.mjs",
    "setup": "node scripts/dev.mjs --setup-only",
    "test": "node scripts/test.mjs",
    "reset": "node -e \"fetch('http://localhost:8000/api/demo/reset',{method:'POST',headers:{'X-Requested-With':'npm'}}).then(r=>r.text()).then(console.log)\"",
    "seed": "node scripts/seed.mjs",
    "shots": "npm install --no-audit --no-fund --silent && node qa/screenshots.mjs"
  },
  "devDependencies": {
    "playwright": "1.56.1",
    "axe-core": "4.14.0"
  }
}
